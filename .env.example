# ==============================================================================
# PLATORIA LOCAL WINDOWS PRINT AGENT — CONFIGURATION
# ==============================================================================

# Platoria Cloudflare Worker URL (e.g., https://your-cafe.domain.workers.dev or custom domain)
PLATORIA_API_URL=https://YOUR_PRODUCTION_PLATORIA_DOMAIN

# Dedicated device token configured in Cloudflare secrets (never commit the real secret)
PRINT_AGENT_TOKEN=REPLACE_WITH_DEVICE_TOKEN

# Unique identifier for this workstation / print station
PRINT_AGENT_ID=restaurant-kitchen-01

# Local SmartPOS Print Bridge loopback base URL
# Default is http://127.0.0.1:8003. If port discovery is enabled, the agent scans ports 8000-8010.
SMARTPOS_BASE_URL=http://127.0.0.1:8003

# Automatically scan candidate ports if primary base URL does not respond
SMARTPOS_AUTO_PORT_DISCOVERY=true
SMARTPOS_PORT_RANGE=8000-8010

# Windows Printer Name as installed in "Printers & scanners"
# Example: "TVS RP 3220 Star" or "TVS Electronics RP 3220 Star"
PRINTER_NAME=TVS RP 3220 Star

# Polling and network timings
POLL_INTERVAL_MS=2000
MAX_EMPTY_POLL_INTERVAL_MS=6000
EMPTY_POLL_STEP_MS=1000
HTTP_TIMEOUT_MS=10000
MAX_ATTEMPTS=3

# Logging & Timezone
LOG_LEVEL=info
LOG_DIR=logs
TIMEZONE=Asia/Kolkata
